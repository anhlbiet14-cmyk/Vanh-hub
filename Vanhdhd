-- Sự kiện bấm nút
ToggleBtn.MouseButton1Click:Connect(function()
	if FlyEnabled then
		StopFly()
		ToggleBtn.Text = "Bay: TẮT"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
	else
		if StartFly() then
			ToggleBtn.Text = "Bay: BẬT"
			ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 90)
		end
	end
end)

MinusBtn.MouseButton1Click:Connect(function()
	FlySpeed = math.max(10, FlySpeed - 10)
	SpeedLabel.Text = "Tốc độ: " .. FlySpeed
end)

PlusBtn.MouseButton1Click:Connect(function()
	FlySpeed = math.min(300, FlySpeed + 10)
	SpeedLabel.Text = "Tốc độ: " .. FlySpeed
end)

-- Kéo thả chuẩn đa chạm (Multi-touch safe) cho cả Mobile & PC
local dragging = false
local dragInput = nil
local dragStart = nil
local startPos = nil

MainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragInput = input
		dragStart = input.Position
		startPos = MainFrame.Position
	end
end)

table.insert(Connections, UserInputService.InputChanged:Connect(function(input)
	if not dragging then return end
	local isValidTouch = (input == dragInput and input.UserInputType == Enum.UserInputType.Touch)
	local isValidMouse = (dragInput and dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)

	if isValidTouch or isValidMouse then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end))

table.insert(Connections, UserInputService.InputEnded:Connect(function(input)
	if input == dragInput then
		dragging = false
		dragInput = nil
	end
end))

-- Lưu hàm dọn dẹp toàn cục cho lần chạy sau
_G.EggFlyCleanup = function()
	StopFly()
	for _, conn in ipairs(Connections) do
		if conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(Connections)
	if ScreenGui then
		ScreenGui:Destroy()
	end
end
